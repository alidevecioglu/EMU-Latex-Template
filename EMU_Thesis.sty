\renewcommand*{\dtlsetUTFviiicharcode}[2]{%
  \ifstrequal{#1}{Ç}%
  {%
    #2=68\relax
  }%
  {%
    \ifstrequal{#1}{Ğ}%
    {%
      #2=72\relax
    }%
    {%
      \ifstrequal{#1}{I}%
      {%
        #2=73\relax
      }%
        {%
          \ifstrequal{#1}{İ}%
          {%
            #2=74\relax
          }%
          {%
            \ifstrequal{#1}{Ö}%
            {%
              #2=80\relax
            }%
            {%
              \ifstrequal{#1}{Ş}%
              {%
                #2=84\relax
              }%
              {%
                \ifstrequal{#1}{Ü}%
                {%
                  #2=86\relax
                }%
                {%
                  \ifstrequal{#1}{ç}%
                  {%
                    #2=100\relax
                  }%
                  {%
                    \ifstrequal{#1}{ğ}%
                    {%
                      #2=104\relax
                    }%
                    {%
                      \ifstrequal{#1}{ı}%
                      {%
                        #2=105\relax
                      }%
                      {%
                          \ifstrequal{#1}{i}%
                          {%
                            #2=106\relax
                          }%
                          {%
                            \ifstrequal{#1}{ö}%
                            {%
                            #2=112\relax
                            }%
                            {%
                              \ifstrequal{#1}{ş}%
                              {%
                                #2=116\relax
                              }%
                              {%
                                \ifstrequal{#1}{ü}%
                                {%
                                  #2=118\relax
                                }%
                                  {%
                                    \dtlsetdefaultUTFviiicharcode{#1}{#2}%
                                  }%
                                }%
                             }%   
                          }%
                       }%
                    }%
                  }%
                }%
              }%
            }%
          }%
        }%
      }%
    }%
  }%



