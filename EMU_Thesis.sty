% Examining committee database ============================
\DTLnewdb{examiner}
\newcommand{\examiner}[3]{%
    \DTLnewrow{examiner}%
        \DTLnewdbentry{examiner}{Title}{#1}%
        \DTLnewdbentry{examiner}{FirstName}{#2}%
        \DTLnewdbentry{examiner}{Surname}{#3}%
        %\DTLnewdbentry{examiner}{Title}{\trim{#1}}%
        %\DTLnewdbentry{examiner}{FirstName}{\trim{#2}}%
        %\DTLnewdbentry{examiner}{Surname}{\trim{#3}}%
}%
% Define necessary lengths
\newlength{\examinerlinedefaultlength}
\setlength{\examinerlinedefaultlength}{170.7168pt}
\newlength{\examinerlinelength}
\newlength{\examinermaxlength}
\newlength{\examinernamelength}
%

% Examining Committee box generator for approval page
\newcommand{\examinerlist}[1]{%
    %\trimspaces{#1}
    % 1. Find the max length of the examiner names
    \setlength{\examinerlinelength}{10pt}
    \setlength{\examinermaxlength}{10pt}
    \DTLforeach{#1}{\etitle=Title,\fname=FirstName,\surname=Surname}
            {
              % remove starting spaces first
              \DTLreplaceentryforrow{Title}{\trim{\etitle}}
              \DTLreplaceentryforrow{FirstName}{\trim{\fname}}
              \DTLreplaceentryforrow{Surname}{\trim{\surname}}
              \dtlrecombine
              
              \settowidth{\examinernamelength}{\etitle~\fname~\surname}
              \ifnumcomp{\examinernamelength}{>}{\examinermaxlength}
                    {\settowidth{\examinermaxlength}{\etitle~\fname~\surname}}
                    {}
            }% 
    % max available length in the examiner list is 398.33836pt or 14cm
    \setlength{\examinerlinelength}{388.33836pt - \examinermaxlength} 
    % if the new line length is more than the default reduce it to default
    \ifnumcomp{\examinerlinelength}{>}{\examinerlinedefaultlength}
                    {\setlength{\examinerlinelength}{170.7168pt}}
                    {}
    % 2. Print the lists
    \DTLsort{Surname,FirstName}{#1}
    \begin{enumerate}[leftmargin=*]
        \setlength{\itemsep}{0pt}
        \setlength{\parskip}{0pt}
        \setlength{\parsep}{0pt}
        \vspace{-14pt}
        \DTLforeach*[\equal{\etitle}{Prof.}]{#1}{\etitle=Title,\fname=FirstName,\surname=Surname}
            {\displayexaminer{Prof.}{\fname}{\surname}}%  
        \DTLforeach*[\equal{\etitle}{Prof. Dr.}]{#1}{\etitle=Title,\fname=FirstName,\surname=Surname}
            {\displayexaminer{Prof. Dr.}{\fname}{\surname}}%  
        \DTLforeach*[\equal{\etitle}{Assoc. Prof. Dr.}]{#1}{\etitle=Title,\fname=FirstName,\surname=Surname}
            {\displayexaminer{Assoc. Prof. Dr.}{\fname}{\surname}}%  
        \DTLforeach*[\equal{\etitle}{Asst. Prof. Dr.}]{#1}{\etitle=Title,\fname=FirstName,\surname=Surname}
            {\displayexaminer{Asst. Prof. Dr.}{\fname}{\surname}}%
        \DTLforeach*[\equal{\etitle}{Assist. Prof. Dr.}]{#1}{\etitle=Title,\fname=FirstName,\surname=Surname}
            {\displayexaminer{Asst. Prof. Dr.}{\fname}{\surname}}%
        \DTLforeach*[\equal{\etitle}{Dr.}]{#1}{\etitle=Title,\fname=FirstName,\surname=Surname}
            {\displayexaminer{Dr.}{\fname}{\surname}}%
    \end{enumerate}
}

\newcommand{\displayexaminer}[3]{
    { \if\relax\etitle\relax \else \item\space{\etitle~\fname~\surname~}
       \hspace{\fill}\makebox[\examinerlinelength] \hrulefill \\ \vspace{-26pt} \fi}%
}



