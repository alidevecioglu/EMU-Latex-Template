% create the list of symbols and/or abbreviations   
\newcommand{\abbrlabel}[1]{\makebox[3cm][l]{#1\hfill}}
\newcommand{\beginsymbollist}{%
    % Remove preceding white spaces
    \DTLforeach{symbols}{\thisAcronym=Acronym,\thisDesc=Description}%
        {\DTLreplaceentryforrow{Acronym}{\trim{\thisAcronym}}}%
    \begin{list}{}{\renewcommand{\makelabel}{\abbrlabel}%
     \setlength{\labelwidth}{3cm}\setlength{\leftmargin}{3.2cm}%
     \setlength{\itemsep}{-5pt}}
    \DTLforeach*{symbols}{\thisAcronym=Acronym,\thisDesc=Description}%
    {\item[\thisAcronym] \thisDesc}%
}
\newcommand{\beginabbrlist}{%
    % Remove preceding white spaces
    \DTLforeach{abbreviation}{\thisAcronym=Acronym,\thisDesc=Description}%
        {\DTLreplaceentryforrow{Acronym}{\trim{\thisAcronym}}}%
    \begin{list}{}{\renewcommand{\makelabel}{\abbrlabel}%
     \setlength{\labelwidth}{3cm}\setlength{\leftmargin}{3.2cm}%
     \setlength{\itemsep}{-5pt}}
    \DTLforeach*{abbreviation}{\thisAcronym=Acronym,\thisDesc=Description}%
    {\item[\thisAcronym] \thisDesc}%
}
\newcommand{\closesymlist}{\end{list}}

