% Signature box generator for approval page
\usepackage{multicol}
\setlength{\columnsep}{1cm}
\newcommand{\signaturelinelength}{18em}
\newcommand{\signaturelinelengthC}{16em}
\newcommand{\signaturebox}[4]{
  \if\relax#3\relax
    \begin{flushright}
        \begin{minipage}{\signaturelinelength}
          \centering{
            \rule{\signaturelinelength}{0.4pt}
            {#1}\\
            {#2}}
        \end{minipage}
    \end{flushright}
  \else
  \begin{multicols}{2}
        \begin{flushleft}
            \begin{minipage}{\signaturelinelengthC}
              \centering{
                \rule{\signaturelinelengthC}{0.4pt}
                {#3}\\
                {#4}}
            \end{minipage}
        \end{flushleft} 
        \begin{flushright}
            \begin{minipage}{\signaturelinelengthC}
              \centering{
                \rule{\signaturelinelengthC}{0.4pt}
                {#1}\\
                {#2}}
            \end{minipage}%
        \end{flushright}
    \end{multicols}
  \fi
}
