% ---------------------------------------------------------------------
% Optional committee-revision markup. Two commands:
%   \revadd{...}  red text  -- material added in response to the committee.
%   \flaghl{...}  yellow highlight -- material that already existed and is
%                 pointed out rather than rewritten (e.g. an already-present
%                 definition the committee asked to see highlighted).
% Both are meant to be stripped before the final bound copy. Rather than
% hand-editing them out, pass \CLEANCOPY on the command line and both
% render as plain text -- nothing in this file needs to change:
%   pdflatex -jobname=EMU_Thesis_formatcheck "\def\CLEANCOPY{1}\input{EMU_Thesis.tex}"
% If you never need this, ignore it -- \revadd{...} and \flaghl{...} are
% just unused commands until you wrap something in them.
% ---------------------------------------------------------------------
\ifdefined\CLEANCOPY
  \newcommand{\revadd}[1]{#1}
  \newcommand{\flaghl}[1]{#1}
\else
  \newcommand{\revadd}[1]{\textcolor{red}{#1}}
  \sethlcolor{yellow}
  \newcommand{\flaghl}[1]{\hl{#1}}
\fi


